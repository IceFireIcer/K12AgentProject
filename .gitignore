# === 依赖 ===
node_modules/
.venv/
__pycache__/
*.py[cod]

# === 构建产物 ===
out/
dist/
build/
*.egg-info/

# electron-builder 把 desktop/build/ 当作 buildResources（放 icon.ico 等）。
# 上面的 build/ 规则会把它一起吞掉，这里显式放回来 —— 图标是源资产，必须提交。
!desktop/build/
!desktop/build/**

# 本仓库的 PyInstaller spec 放在 server/packaging/（而不是 server/build/），
# 正是为了不被上面的 build/ 规则误伤 —— spec 是源文件，必须提交。

# === 运行时数据目录（sidecar 的 --data-dir）===
# 用通配覆盖所有变体：_data / _data_smoke / _data_packaged_check …
# 逐个列举过一版，结果漏掉了新加的那个 —— 通配更省心。
server/_data*/

# === 运行时数据（含学生隐私数据，绝不入库）===
*.sqlite
*.sqlite3
*.db
*.sqlite-wal
*.sqlite-shm

# === 模型与本地资源（体积大，随包分发不入库）===
# 注意：必须用 **/ 前缀。含中间斜杠的模式会被锚定到仓库根目录，
# 写 "resources/models/" 匹配不到 "server/resources/models/"。
**/resources/models/
**/resources/pyodide/

# === 配置与凭据（含 API Key）===
config.json
.env
.env.local
*.local.json

# === 日志与临时文件 ===
logs/
*.log
.DS_Store
Thumbs.db

# === 编辑器 ===
.idea/
.vscode/*
!.vscode/extensions.json

# === 本地工具状态（编辑器/代理的会话与计划快照，与项目无关）===
.zcode/

# === Python ===
# 注意：uv.lock 与 .python-version 必须提交（锁定依赖与解释器版本）
uv.lock.bak
