{
  "name": "k12-agent-ui",
  "version": "0.1.0",
  "private": true,
  "description": "K12Agent 界面原型（Vue3 + Element Plus）——由 Pencil 画布设计稿生成，暂不接入 IPC/契约",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:buttons": "node scripts/audit-buttons.mjs",
    "check": "npm run typecheck && npm run check:contrast -- --strict && npm run check:buttons"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "element-plus": "^2.14.5",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@vitejs/plugin-vue": "^6.0.2",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.0",
    "vue-tsc": "^3.1.6"
  }
}
