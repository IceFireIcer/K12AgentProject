{
  "name": "k12-agent-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "智团团 —— K12 AI 通识课教学助手（桌面端：Electron 壳 + Vue + Pi Agent 运行时）",
  "author": "智团团",
  "main": "./out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node --test \"tests/**/*.test.ts\" && npm run check:api && npm run check:tool-schema",
    "test:unit": "node --test \"tests/**/*.test.ts\"",
    "gen:api": "node scripts/gen-api-types.mjs",
    "check:api": "node scripts/gen-api-types.mjs --check",
    "gen:tokens": "node scripts/design/gen-tokens.mjs",
    "check:contrast": "node scripts/design/check-contrast.mjs",
    "smoke:pi": "node scripts/pi-smoke.mjs",
    "smoke:imports": "node scripts/pi-import-graph.mjs",
    "trace:export": "node src/main/agent/trace.ts --repo-root ..",
    "check:tool-schema": "node scripts/check-tool-schema.mjs",
    "smoke:wire": "node scripts/wire-smoke.mjs",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@sinclair/typebox": "^0.34.0",
    "animejs": "^3.2.2",
    "element-plus": "^2.14.5",
    "lucide-vue-next": "^1.0.0",
    "monaco-editor": "^0.56.0",
    "pinia": "^4.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.0",
    "electron-vite": "^5.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.1.6"
  }
}
