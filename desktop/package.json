{
  "name": "k12-agent-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "智团团 —— K12 AI 通识课教学助手（桌面端：Electron 壳 + Vue + Pi Agent 运行时）",
  "author": "智团团",
  "main": "./out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node --test \"tests/**/*.test.ts\" && npm run check:api && npm run check:tool-schema && npm run check:docs",
    "version:stamp": "node scripts/build-version.mjs --write",
    "version:show": "node scripts/build-version.mjs",
    "test:unit": "node --test \"tests/**/*.test.ts\"",
    "gen:api": "node scripts/gen-api-types.mjs",
    "check:api": "node scripts/gen-api-types.mjs --check",
    "gen:tokens": "node scripts/design/gen-tokens.mjs",
    "check:contrast": "node scripts/design/check-contrast.mjs",
    "smoke:pi": "node scripts/pi-smoke.mjs",
    "smoke:imports": "node scripts/pi-import-graph.mjs",
    "trace:export": "node src/main/agent/trace.ts --repo-root ..",
    "check:tool-schema": "node scripts/check-tool-schema.mjs",
    "smoke:wire": "node scripts/wire-smoke.mjs",
    "ux": "node scripts/ux-audit.mjs",
    "ux:reload": "node scripts/ux-reload.mjs",
    "ux:scroll": "node scripts/ux-probe-scroll-behavior.mjs",
    "ux:busy": "node scripts/ux-probe-busy-send.mjs",
    "ux:attribute": "node scripts/ux-scroll-attribution.mjs",
    "ux:pages": "node scripts/ux-pages-audit.mjs",
    "ux:layout": "node scripts/ux-layout-audit.mjs",
    "ux:student": "node scripts/ux-student-view-scan.mjs",
    "guards:mutation": "node scripts/verify-guard-mutations.mjs",
    "build:server": "node scripts/build-server.mjs",
    "check:server": "node scripts/build-server.mjs --check dist",
    "check:server:packaged": "node scripts/build-server.mjs --check packaged",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:docs": "node scripts/doc-facts.mjs",
    "check:docs:tests": "node scripts/doc-facts.mjs --tests",
    "build": "npm run build:server && npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir && npm run check:server:packaged",
    "build:portable": "npm run build && electron-builder --win portable && npm run check:server:packaged",
    "build:win": "npm run build && electron-builder --win && npm run check:server:packaged",
    "postinstall": "electron-builder install-app-deps",
    "ux:nonce": "node scripts/ux-probe-animation-nonce.mjs",
    "ux:stage": "node scripts/ux-probe-stage-size.mjs",
    "ux:demo": "node scripts/ux-probe-demo.mjs",
    "ux:motion": "node scripts/ux-probe-reduced-motion.mjs",
    "ux:perf": "node scripts/ux-probe-perf.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@types/node": "^22.19.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "animejs": "^3.2.2",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.0",
    "electron-vite": "^5.0.0",
    "element-plus": "^2.14.5",
    "lucide-vue-next": "^1.0.0",
    "monaco-editor": "^0.56.0",
    "openapi-typescript": "^7.13.0",
    "pinia": "^4.0.0",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.1.6",
    "vue-virtual-scroller": "^3.0.5"
  }
}
