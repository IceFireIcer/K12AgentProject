{
  "openapi": "3.1.0",
  "info": {
    "title": "K12 AI 教学助手 · sidecar",
    "description": "Electron 桌面壳的本地后端（仅绑定 127.0.0.1）",
    "version": "0.1.0-dev"
  },
  "paths": {
    "/api/chat/stream/echo": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Chat Stream Echo",
        "description": "**S02 临时端点**：回放一段假的 SSE 数据流。\n\n⚠️ 为什么用 POST：真实链路（S03）是 POST + JSON body，前端解析器必须按\nPOST + `fetch` 写，不能因为\"反正是 echo\"就退回 GET。",
        "operationId": "chat_stream_echo_api_chat_stream_echo_post",
        "parameters": [
          {
            "name": "interval_ms",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 0,
              "description": "事件间隔，便于肉眼看逐条到达",
              "default": 15,
              "title": "Interval Ms"
            },
            "description": "事件间隔，便于肉眼看逐条到达"
          },
          {
            "name": "all_events",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "是否补发 blocked/error 以覆盖全部 6 种事件",
              "default": false,
              "title": "All Events"
            },
            "description": "是否补发 blocked/error 以覆盖全部 6 种事件"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-sse-events": [
          "delta",
          "citation",
          "payload",
          "blocked",
          "done",
          "error"
        ],
        "x-sse-media-type": "text/event-stream; charset=utf-8"
      }
    },
    "/api/meta": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Meta",
        "description": "给前端展示的后端元信息（不含任何凭据）。",
        "operationId": "meta_api_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Meta Api Meta Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/ping": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Ping",
        "description": "受保护端点：能返回 200 说明 token 校验通过。",
        "operationId": "ping_api_ping_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Get Settings",
        "description": "读取设置（**脱敏**）。",
        "operationId": "get_settings_api_settings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "settings"
        ],
        "summary": "Put Settings",
        "description": "保存设置。\n\n⚠️ 日志只记\"改了哪些字段\"，**绝不记值**（值里可能有 key）。",
        "operationId": "put_settings_api_settings_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "description": "免鉴权健康检查。",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnimationPayload": {
        "additionalProperties": false,
        "description": "动画讲解产物。**必须带降级文本**：生成失败也要能讲课（执行文档 11.2）。",
        "properties": {
          "concept": {
            "title": "Concept",
            "type": "string"
          },
          "html": {
            "default": "",
            "description": "完整自包含 HTML（内联 Anime.js v3 调用），在 sandboxed iframe 内运行",
            "title": "Html",
            "type": "string"
          },
          "durationMs": {
            "default": 6000,
            "minimum": 0,
            "title": "Durationms",
            "type": "integer"
          },
          "fallbackText": {
            "description": "降级为文字讲解（生成失败/沙箱不可用时使用）",
            "title": "Fallbacktext",
            "type": "string"
          },
          "fallbackImage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "静态兜底图（SVG dataURL），无网络依赖",
            "title": "Fallbackimage"
          },
          "source": {
            "default": "template",
            "enum": [
              "template",
              "generated"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "concept",
          "fallbackText"
        ],
        "title": "AnimationPayload",
        "type": "object"
      },
      "AnswerKind": {
        "description": "`event: payload` 里承载的是哪种 SubAgent 产物。",
        "enum": [
          "animation",
          "coding",
          "quiz"
        ],
        "title": "AnswerKind",
        "type": "string"
      },
      "ChatRequest": {
        "properties": {
          "studentId": {
            "type": "string",
            "title": "Studentid"
          },
          "grade": {
            "$ref": "#/components/schemas/GradeLevel"
          },
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message"
          },
          "sessionId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sessionid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "studentId",
          "grade",
          "message"
        ],
        "title": "ChatRequest",
        "description": "`POST /api/chat/stream` 请求体（执行文档 6.3）。\n\n- `grade` 由前端按钮决定，**不让模型推断**。\n- `session_id` 为空时后端生成；S04 起作为 LangGraph `thread_id`（跨会话记忆 / 断点续跑）。"
      },
      "Citation": {
        "additionalProperties": false,
        "description": "检索命中的引用。\n\n`compat=True` 表示「允许向上兼容命中了更高学段的内容」——\n**必须显式标注**，前端会展示「已为你补充高年级内容」提示（AGENTS §5.4）。",
        "properties": {
          "chunkId": {
            "title": "Chunkid",
            "type": "string"
          },
          "chapterTitle": {
            "default": "",
            "title": "Chaptertitle",
            "type": "string"
          },
          "sectionTitle": {
            "default": "",
            "title": "Sectiontitle",
            "type": "string"
          },
          "gradeLevel": {
            "$ref": "#/components/schemas/GradeLevel"
          },
          "compat": {
            "default": false,
            "title": "Compat",
            "type": "boolean"
          }
        },
        "required": [
          "chunkId",
          "gradeLevel"
        ],
        "title": "Citation",
        "type": "object"
      },
      "CodeError": {
        "additionalProperties": false,
        "description": "代码运行错误（执行文档 6.5 引用但未展开，此处冻结）。",
        "properties": {
          "type": {
            "description": "异常类型，如 ZeroDivisionError",
            "title": "Type",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Line"
          }
        },
        "required": [
          "type",
          "message"
        ],
        "title": "CodeError",
        "type": "object"
      },
      "CodeEvaluation": {
        "additionalProperties": false,
        "description": "`POST /api/code/run-hint` 响应：评估 + 下一级提示。",
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "stdout": {
            "default": "",
            "title": "Stdout",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CodeError"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "feedback": {
            "description": "面向学生的中文反馈",
            "title": "Feedback",
            "type": "string"
          },
          "nextHint": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CodingHint"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "ok",
          "feedback"
        ],
        "title": "CodeEvaluation",
        "type": "object"
      },
      "CodeRunRequest": {
        "additionalProperties": false,
        "description": "学生提交的代码与报错。\n\n⚠️ 代码**在渲染进程的 Pyodide Worker 里执行**（沙箱要求，AGENTS §5.7）；\n这里只接收执行结果，后端不执行学生代码。",
        "properties": {
          "studentId": {
            "title": "Studentid",
            "type": "string"
          },
          "kpId": {
            "title": "Kpid",
            "type": "string"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "stdout": {
            "default": "",
            "title": "Stdout",
            "type": "string"
          },
          "stderr": {
            "default": "",
            "title": "Stderr",
            "type": "string"
          }
        },
        "required": [
          "studentId",
          "kpId",
          "code"
        ],
        "title": "CodeRunRequest",
        "type": "object"
      },
      "CodeTemplate": {
        "additionalProperties": false,
        "description": "编程题脚手架。",
        "properties": {
          "kpId": {
            "title": "Kpid",
            "type": "string"
          },
          "language": {
            "const": "python",
            "default": "python",
            "title": "Language",
            "type": "string"
          },
          "scaffold": {
            "description": "预置代码框架，含 TODO 标记",
            "title": "Scaffold",
            "type": "string"
          },
          "expectedBehavior": {
            "title": "Expectedbehavior",
            "type": "string"
          }
        },
        "required": [
          "kpId",
          "scaffold",
          "expectedBehavior"
        ],
        "title": "CodeTemplate",
        "type": "object"
      },
      "CodingHint": {
        "additionalProperties": false,
        "description": "分级提示（1 最弱、3 最强）。提示要「引导」而不是「给答案」。",
        "properties": {
          "level": {
            "enum": [
              1,
              2,
              3
            ],
            "title": "Level",
            "type": "integer"
          },
          "hint": {
            "title": "Hint",
            "type": "string"
          }
        },
        "required": [
          "level",
          "hint"
        ],
        "title": "CodingHint",
        "type": "object"
      },
      "DepNode": {
        "additionalProperties": false,
        "description": "依赖图节点（`GET /api/graph/deps/{kp_id}`）。\n\n**双用途**（执行文档 8.5，创新点）：\n① 推荐路径规划（`relation=prerequisite` 反向找前置 / 正向找下一步）；\n② 检索上下文扩展（把相邻知识点纳入检索范围）。",
        "properties": {
          "kpId": {
            "title": "Kpid",
            "type": "string"
          },
          "name": {
            "default": "",
            "title": "Name",
            "type": "string"
          },
          "gradeLevel": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GradeLevel"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "relation": {
            "default": "prerequisite",
            "enum": [
              "prerequisite",
              "related"
            ],
            "title": "Relation",
            "type": "string"
          },
          "weight": {
            "default": 1.0,
            "minimum": 0.0,
            "title": "Weight",
            "type": "number"
          },
          "distance": {
            "default": 1,
            "description": "相对查询节点的跳数",
            "minimum": 1,
            "title": "Distance",
            "type": "integer"
          }
        },
        "required": [
          "kpId"
        ],
        "title": "DepNode",
        "type": "object"
      },
      "EmbeddingConfig": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "local_fastembed",
              "cloud_api",
              "none"
            ],
            "title": "Mode",
            "default": "local_fastembed"
          },
          "baseUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseurl"
          },
          "apiKey": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Apikey"
          },
          "modelId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Modelid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "EmbeddingConfig",
        "description": "嵌入配置。默认本地 fastembed（离线可用）；云端为可选降级路径（执行文档 8.4 [2]）。"
      },
      "GradeLevel": {
        "type": "string",
        "enum": [
          "primary_low",
          "primary_high",
          "junior",
          "senior"
        ],
        "title": "GradeLevel",
        "description": "学段。**由前端按钮切换并随请求传入**；SubAgent 不得自行推断（AGENTS §5.1）。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "固定为 ok；不可用时该接口本身就不会响应"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "embedder_ready": {
            "type": "boolean",
            "title": "Embedder Ready",
            "description": "嵌入模型「可用」的快速探测结果。S01 阶段只检查模型文件是否随包分发到位，不做真实加载（加载 90MB ONNX 会显著拖慢冷启动）；S06 接入 RAG 后改为懒加载后的真实就绪态。"
          },
          "frozen": {
            "type": "boolean",
            "title": "Frozen",
            "description": "是否运行在 PyInstaller 打包产物中"
          },
          "data_dir": {
            "type": "string",
            "title": "Data Dir"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "embedder_ready",
          "frozen",
          "data_dir"
        ],
        "title": "HealthResponse",
        "description": "`/health` 响应。Electron 轮询它来判断 sidecar 是否就绪。"
      },
      "Intent": {
        "description": "主 Agent 的意图路由结果。四个值对应四种核心交互，无第五种。",
        "enum": [
          "qa",
          "animation",
          "coding",
          "quiz"
        ],
        "title": "Intent",
        "type": "string"
      },
      "LlmConfig": {
        "properties": {
          "providerName": {
            "type": "string",
            "title": "Providername",
            "description": "供应商名称，仅用于界面展示，不参与调用",
            "default": "DeepSeek"
          },
          "baseUrl": {
            "type": "string",
            "title": "Baseurl",
            "description": "OpenAI 兼容 BaseURL（含 /v1 之类路径前缀）",
            "default": "https://api.deepseek.com/v1"
          },
          "apiKey": {
            "type": "string",
            "title": "Apikey",
            "description": "本地存储；不上传、不入日志",
            "default": ""
          },
          "modelId": {
            "type": "string",
            "title": "Modelid",
            "description": "模型 ID，如 deepseek-chat",
            "default": "deepseek-chat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "LlmConfig",
        "description": "主模型配置（OpenAI 兼容）。\n\n`base_url` / `model_id` 必须可改：**不得把任何供应商硬编码进代码**\n（执行文档 5.1；答辩时会被问「换供应商要不要改代码」）。"
      },
      "MasteryItem": {
        "additionalProperties": false,
        "description": "单知识点掌握度（对应 `mastery` 表）。",
        "properties": {
          "kpId": {
            "title": "Kpid",
            "type": "string"
          },
          "kpName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "知识点中文名，便于界面直出",
            "title": "Kpname"
          },
          "score": {
            "default": 0.0,
            "description": "0..1 掌握度",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "number"
          },
          "attempts": {
            "default": 0,
            "title": "Attempts",
            "type": "integer"
          },
          "correct": {
            "default": 0,
            "title": "Correct",
            "type": "integer"
          },
          "lastSeenAt": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Lastseenat"
          }
        },
        "required": [
          "kpId"
        ],
        "title": "MasteryItem",
        "type": "object"
      },
      "PingResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "auth": {
            "type": "string",
            "title": "Auth",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "PingResponse",
        "description": "受保护端点，用于验证 `X-Auth-Token` 中间件确实生效。"
      },
      "ProgressItem": {
        "additionalProperties": false,
        "description": "闯关进度（对应 `progress` 表），S09 使用。",
        "properties": {
          "kpId": {
            "title": "Kpid",
            "type": "string"
          },
          "stage": {
            "enum": [
              "locked",
              "learning",
              "quizzed",
              "mastered"
            ],
            "title": "Stage",
            "type": "string"
          },
          "badge": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Badge"
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Updatedat"
          }
        },
        "required": [
          "kpId",
          "stage"
        ],
        "title": "ProgressItem",
        "type": "object"
      },
      "QuizAnswer": {
        "additionalProperties": false,
        "description": "单题作答。",
        "properties": {
          "qid": {
            "title": "Qid",
            "type": "string"
          },
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ],
            "title": "Answer"
          }
        },
        "required": [
          "qid",
          "answer"
        ],
        "title": "QuizAnswer",
        "type": "object"
      },
      "QuizGradeRequest": {
        "additionalProperties": false,
        "description": "`POST /api/quiz/grade` 请求（混合批改：客观题规则、主观题大模型）。",
        "properties": {
